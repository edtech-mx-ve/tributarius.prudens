APP_NAME=Tributarius prudens
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_DOCS=true
DATABASE_URL=sqlite:///./tributarius.db


TRUSTED_HOSTS_CSV=127.0.0.1,localhost,testserver
MAX_REQUEST_BODY_BYTES=1048576
CONSULTATION_RATE_LIMIT=30
CONSULTATION_RATE_WINDOW_SECONDS=60


RAG_ARTIFACT_DIR=deployment/runtime_artifacts_semantic_v2
REQUIRE_RAG_ARTIFACTS=false
RAG_LOCAL_FILES_ONLY=true
VERIFY_RAG_INTEGRITY=true
LEGAL_RETRIEVAL_POLICY_PATH=app/resources/legal_retrieval_policy.json
RUNTIME_RULE_SET_PATH=rules/examples/basic_obligations.json
RUNTIME_RBS_INVENTORY_PATH=app/resources/current_rbs_inventory.json
RUNTIME_RULE_SET_DIR=rules/production

TEMPORAL_PROVENANCE_REGISTRY_PATH=knowledge/temporal/temporal_provenance_registry.json
REQUIRE_TEMPORAL_PROVENANCE_REGISTRY=false

# F.11 — Llama real local (llama.cpp + GGUF). El mock queda reservado a tests.
LLM_RUNTIME_PROVIDER=llama_cpp
REQUIRE_REAL_LLAMA=true
LLAMA_MODEL_PATH=models/Llama-3.2-1B-Instruct-Q4_K_M.gguf
LLAMA_MODEL_URL=https://huggingface.co/unsloth/Llama-3.2-1B-Instruct-GGUF/resolve/b69aef112e9f895e6f98d7ae0949f72ff09aa401/Llama-3.2-1B-Instruct-Q4_K_M.gguf
LLAMA_MODEL_SHA256=3f5a22426976ab26cfe84dba63c1d08391717abb1af893e10f1b2968d862dcc1
LLAMA_N_CTX=4096
LLAMA_MAX_TOKENS=700
LLAMA_SEED=42
LLAMA_N_THREADS=1
LLAMA_N_BATCH=128

# Compatibilidad histórica P.1/P.2 — OpenRouter (no objetivo actual).
# Para activarlo en despliegue: LLM_RUNTIME_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=180

# Prototipo web gratuito — Llama 3.3 70B mediante Cloudflare Workers AI.
# Para activarlo: LLM_RUNTIME_PROVIDER=cloudflare_workers_ai
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_WORKERS_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_WORKERS_AI_TIMEOUT_SECONDS=180
