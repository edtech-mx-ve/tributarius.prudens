# Plantilla pública. No introducir secretos ni datos fiscales reales.
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_DOCS=true
DATABASE_URL=sqlite:///./tributarius.db
TRUSTED_HOSTS_CSV=127.0.0.1,localhost,testserver
MAX_REQUEST_BODY_BYTES=1048576
CONSULTATION_RATE_LIMIT=30
CONSULTATION_RATE_WINDOW_SECONDS=60

DEPLOYMENT_PLATFORM=local
RUNTIME_PROFILE=development
RAG_ARTIFACT_DIR=indexes/runtime
REQUIRE_RAG_ARTIFACTS=false
