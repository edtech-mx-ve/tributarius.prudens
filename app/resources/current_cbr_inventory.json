{
  "schema_version": "1.0",
  "baseline_commit": "b65dc014e57042ef4826354fa5ccb9b0610c0c4f",
  "purpose": "Inventario C.1 del CBR preexistente que servirá de línea base para CBR Primario 1.0. Registra estructura, persistencia, similitud, recuperación, reutilización, seguridad, trazabilidad e integración híbrida sin redefinir ni modificar el motor actual.",
  "components": [
    {
      "path": "app/domain/cbr.py",
      "role": "domain",
      "responsibility": "Modelos de caso, consulta, similitud, reutilización, revisión y retención CBR."
    },
    {
      "path": "app/domain/cbr_trace.py",
      "role": "trace_domain",
      "responsibility": "Modelos estructurados para la trazabilidad de recuperación y reutilización CBR."
    },
    {
      "path": "app/models/cbr.py",
      "role": "persistence_model",
      "responsibility": "Modelo SQLAlchemy persistente para la tabla cbr_cases."
    },
    {
      "path": "app/repositories/cbr.py",
      "role": "repository",
      "responsibility": "Persistencia y recuperación de casos activos o históricos desde la base de datos."
    },
    {
      "path": "app/services/cbr_anonymizer.py",
      "role": "anonymization",
      "responsibility": "Redacción básica de identificadores y obligación de revisión humana posterior."
    },
    {
      "path": "app/services/cbr_loader.py",
      "role": "loader",
      "responsibility": "Carga segura de corpus JSONL anonimizado y previamente validado."
    },
    {
      "path": "app/services/cbr_reasoning.py",
      "role": "reuse_reasoning",
      "responsibility": "Control de reutilización, compatibilidad normativa y adaptación humana de casos."
    },
    {
      "path": "app/services/cbr_retention.py",
      "role": "retention",
      "responsibility": "Creación determinista de candidatos de retención sin activación automática."
    },
    {
      "path": "app/services/cbr_traceability.py",
      "role": "traceability",
      "responsibility": "Construcción determinista y auditable de la traza del razonamiento CBR."
    },
    {
      "path": "cbr/engine.py",
      "role": "retrieval_engine",
      "responsibility": "Recuperación y ranking de casos con umbral mínimo y coincidencia de campos críticos."
    },
    {
      "path": "cbr/similarity.py",
      "role": "similarity",
      "responsibility": "Normalización textual y cálculo ponderado de similitud por siete campos."
    },
    {
      "path": "migrations/versions/0002_cbr_cases.py",
      "role": "migration",
      "responsibility": "Migración de base de datos que crea la persistencia de casos CBR."
    },
    {
      "path": "scripts/load_cbr_cases.py",
      "role": "cli_loader",
      "responsibility": "Comando para validar o persistir un corpus CBR JSONL."
    },
    {
      "path": "scripts/retrieve_similar_cases.py",
      "role": "cli_retrieval",
      "responsibility": "Comando para ejecutar recuperación explicable de casos desde archivos."
    },
    {
      "path": "app/services/hybrid_orchestrator.py",
      "role": "hybrid_integration",
      "responsibility": "Integra recuperación y evaluación CBR dentro del orquestador híbrido RBS-CBR."
    },
    {
      "path": "app/domain/orchestration.py",
      "role": "orchestration_contract",
      "responsibility": "Expone la consulta y el resultado CBR dentro del contrato de orquestación."
    },
    {
      "path": "cbr/fixtures/cases_test.jsonl",
      "role": "fixture_cases",
      "responsibility": "Tres casos sintéticos usados para validar recuperación, estados y revisión."
    },
    {
      "path": "cbr/fixtures/query_test.json",
      "role": "fixture_query",
      "responsibility": "Consulta sintética reproducible usada por las pruebas del CBR actual."
    }
  ],
